# Vendor API keys for every model call Winnie makes.
#
# Copy this file to `.env` (gitignored) and fill in the keys you use. No other
# module reads, stores or names these variables: winnie-llm resolves a supplier
# id to one of the names below and sends the value on the vendor request.
#
# The process environment can override a value for a one-off run, but `.env` is
# the place a key belongs. Restart the API after editing it.
#
# A supplier id that is not listed here maps to <SUPPLIER>_API_KEY, so a custom
# supplier such as `deepseek-work` reads DEEPSEEK_WORK_API_KEY.

# DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# OpenAI (https://platform.openai.com)
OPENAI_API_KEY=

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Alibaba Cloud DashScope / Qwen
DASHSCOPE_API_KEY=

# Volcengine Doubao speech (recording-file and streaming ASR)
VOLCENGINE_ASR_API_KEY=

# Zhipu AI / BigModel (https://open.bigmodel.cn); OpenAI-compatible root is /v4
ZHIPU_API_KEY=
