# Backup copy of the vendor API keys.
#
# Each supplier's key is stored with its model catalog in data/ai.yaml, and the
# console (Admin -> AI providers -> API key) writes the same value here after
# every save. The registry is the source: editing only this file changes
# nothing, and a key set here before the upgrade is imported into the registry
# once on the next start.
#
# Two jobs are left for this file:
#   * a readable copy for an operator, grouped by the names below;
#   * the credential a gateway-only deployment (ai.enabled: false) injects,
#     since it has no registry to read.
#
# A supplier id that is not listed here maps to <SUPPLIER>_API_KEY, so a custom
# supplier such as `deepseek-work` is mirrored under DEEPSEEK_WORK_API_KEY.

# DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# OpenAI (https://platform.openai.com)
OPENAI_API_KEY=

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Alibaba Cloud DashScope / Qwen
DASHSCOPE_API_KEY=

# Volcengine Doubao speech (recording-file and streaming ASR)
VOLCENGINE_ASR_API_KEY=

# Zhipu AI / BigModel (https://open.bigmodel.cn); OpenAI-compatible root is /v4
ZHIPU_API_KEY=
