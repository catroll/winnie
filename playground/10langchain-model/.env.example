# 至少配置一个 provider。未写的项可留空，Factory 会跳过或报错提示。
#
# OpenAI 官方
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
#
# DeepSeek（OpenAI 兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
#
# Qwen / 通义（OpenAI 兼容，按你的网关改 BASE_URL）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
#
# Claude：若走官方 Anthropic，可另装 langchain-anthropic；
# 本 Demo 默认仍用 OpenAI 兼容代理（许多网关把 Claude 暴露成 /v1/chat/completions）
CLAUDE_API_KEY=
CLAUDE_BASE_URL=
CLAUDE_MODEL=claude-3-5-sonnet-latest
#
# 默认选用的 provider：openai | deepseek | qwen | claude
DEFAULT_PROVIDER=openai
