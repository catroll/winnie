# Copy to apps/api/.env (gitignored). `make api` and `make android` source it.
#
# Public base URL baked into the Android APK as DEFAULT_SERVER_URL. Leave it
# unset to fall back to http://10.0.2.2:8000, the emulator's host loopback.
WINNIE_PUBLIC_URL=http://10.0.2.2:8000

# Vendor API keys are NOT read from here. They live in
# packages/winnie-llm/.env and are managed by the winnie-llm package; start
# from packages/winnie-llm/.env.example.
