# 上游 OpenAI 兼容端点（必填）
UPSTREAM_API_KEY=
UPSTREAM_BASE_URL=https://api.openai.com/v1
# 可选：GET /v1/models 失败时回退展示
UPSTREAM_DEFAULT_MODEL=gpt-4o-mini

# 本服务
WINNIE_HOST=127.0.0.1
WINNIE_PORT=8000
# 若设置，则要求客户端 Authorization: Bearer <WINNIE_API_KEY>
WINNIE_API_KEY=

# 本地沟通日志目录（相对仓库根或绝对路径）
WINNIE_LOG_DIR=../../data/logs/openai-proxy
