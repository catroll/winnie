# 上游 OpenAI 兼容端点
UPSTREAM_API_KEY=
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_DEFAULT_MODEL=gpt-4o-mini
WINNIE_LOG_DIR=../../data/logs/openai-proxy

# 上游 Anthropic 原生 API
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5
ANTHROPIC_LOG_DIR=../../data/logs/anthropic-proxy

# 本服务
WINNIE_HOST=127.0.0.1
WINNIE_PORT=8000
# 若设置，则要求客户端 Authorization: Bearer … 或 x-api-key
WINNIE_API_KEY=
