# Development proxy target for the Vite dev server. The browser always talks to
# the admin origin; only this server-side proxy needs the API address.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional absolute API origin, baked into the client at build time. Leave it
# unset for the supported same-origin deployment (a reverse proxy forwards
# /api, /healthz, /readyz and /routes to the API). Setting it cross-origin
# requires CORS on the API, which is not configured.
# VITE_API_BASE_URL=http://127.0.0.1:8000
