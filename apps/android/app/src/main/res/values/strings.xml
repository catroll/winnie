    <string name="alerts_server_counts">Connected devices: %1$d · pending notifications: %2$d</string>
    <string name="alerts_server_body">A notification is stored before it is sent, so a phone that was offline still receives it on the next connect. The server keeps it for the configured retention window.</string>
    <string name="alerts_troubleshoot">If reminders stop arriving, open the app once. Some vendors end background services aggressively even with battery optimization disabled, and the boot receiver cannot restart the service until the phone finishes booting.</string>
