    <!-- Alerts / background connection -->
    <string name="alerts_title">Alerts &amp; background</string>
    <string name="alerts_how_title">How this works</string>
    <string name="alerts_how_body">Winnie keeps one connection open from a foreground service so a reminder or a finished task reaches you without polling. Android shows a persistent, low-priority notification while that connection runs, and it costs some battery.</string>
    <string name="alerts_no_vendor">There is no Google or vendor push service: the connection is between this phone and your Winnie server. That is why it needs the foreground service.</string>
