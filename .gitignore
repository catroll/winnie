# 本地 / 生成物（不入库）
# Tool caches kept inside the checkout ($HOME is read-only here).
.cache/
**/logs/
data/logs/
data/usage/
data/*.db
data/*.db-*
data/meetings/
data/kb/
data/news/
# Admin-managed AI providers; generated on first start and machine-local.
data/ai.yaml
data/.ai.yaml*
# Winnie gateway keys (digests only, but still a credential file).
data/gateway-keys.yaml
data/.gateway-keys-*
**/__pycache__/
**/.venv/
**/.env
apps/api/config.local.yaml

# Tool caches kept inside the checkout (uv, Firefox profiles).
.cache/
.idea/

# Android build, SDK and caches (machine-local, large, reproducible)
.android-sdk/
.android-user/
.gradle-home/
.gradle-dist/
.home/
.tmp/
apps/android/local.properties
apps/android/.gradle/
apps/android/.kotlin/
apps/android/build/
apps/android/app/build/
apps/android/app/release/
# The sherpa-onnx AAR is a 47 MB third-party release artifact. It is fetched by
# `make android-kws` and never committed; the keyword model under app/src/main/
# assets/kws is small and committed, so a build never downloads the model.
apps/android/app/libs/
